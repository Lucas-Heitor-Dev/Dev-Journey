#  Dev Journey - .gitignore
#  Python · C++ · Lua / Linux / Windows /

#CLAUDE GIT IGNORE

# Secrets & credentials (NEVER commit these)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.*
credentials.json
service-account*.json
token.json
*.secret

# Operating Systems

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / builds
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
*.whl
pip-log.txt

# Tests, coverage & type checkers
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json


# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py


